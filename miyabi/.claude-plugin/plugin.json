{
  "name": "miyabi",
  "version": "1.0.0",
  "description": "Autonomous development framework that converts GitHub issues into completed pull requests using AI",
  "displayName": "Miyabi - Autonomous Development",
  "author": {
    "name": "ShunsukeHayashi",
    "email": "contact@example.com",
    "url": "https://github.com/ShunsukeHayashi"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShunsukeHayashi/Miyabi.git"
  },
  "homepage": "https://github.com/ShunsukeHayashi/Miyabi",
  "keywords": [
    "autonomous-development",
    "github-automation",
    "mcp-server",
    "code-generation",
    "ai-coding",
    "pull-requests"
  ],
  "license": "MIT",
  "engines": {
    "claude": ">=1.0.0"
  },
  "components": {
    "mcpServers": {
      "miyabi": {
        "description": "Miyabi MCP server for autonomous development",
        "command": "npx",
        "args": ["-y", "miyabi-server"],
        "env": {
          "GITHUB_TOKEN": "${GITHUB_TOKEN}"
        }
      }
    }
  },
  "configuration": {
    "properties": {
      "GITHUB_TOKEN": {
        "type": "string",
        "description": "GitHub personal access token for repository operations",
        "required": true
      }
    }
  }
}
